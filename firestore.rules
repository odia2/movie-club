rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'bogdan17261726@gmail.com'; }
    function approved() { return signedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true); }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid
        && request.resource.data.approved == isAdmin()
        && request.resource.data.role == (isAdmin() ? 'admin' : 'member');
      allow update: if isAdmin();
      match /entries/{entry} {
        allow read: if approved();
        allow write: if approved() && request.auth.uid == uid;
      }
    }
    match /posts/{post} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.uid == request.auth.uid;
      allow update: if approved();
      allow delete: if approved() && (isAdmin() || resource.data.uid == request.auth.uid);
      match /comments/{c} {
        allow read: if approved();
        allow create: if approved() && request.resource.data.uid == request.auth.uid;
        allow delete: if approved() && (isAdmin() || resource.data.uid == request.auth.uid);
      }
    }
    // Стара колекція: тільки адмін (потрібна для кнопки «Імпорт зі старої бази»)
    match /movies/{m} { allow read, write: if isAdmin(); }
  }
}
